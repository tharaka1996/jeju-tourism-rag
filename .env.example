# ============================================================
# Jeju Tourism AI Assistant - Environment Configuration
# ============================================================

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./vectorstore
CHROMA_COLLECTION_NAME=jeju_tourism_knowledge

# Embedding Model Configuration
# Free local HuggingFace / Sentence Transformers model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM Provider Configuration
# Options: 'local_fallback', 'ollama', 'openai'
DEFAULT_LLM_PROVIDER=local_fallback

# Ollama Settings (Optional, for local Ollama server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# OpenAI API Settings (Optional, if using paid OpenAI API)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Retrieval Hyperparameters
TOP_K_RETRIEVAL=3
SIMILARITY_SCORE_THRESHOLD=0.35
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
